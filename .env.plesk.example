# Plesk Production Environment
# Copy this file to .env.plesk on the server and fill in the real values there.
# Do not commit .env.plesk with production secrets.

## Database
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_PASSWORD=replace_with_strong_app_password

## Backend
JWT_SECRET=replace_with_strong_jwt_secret
JWT_EXPIRES_IN=7d
BACKEND_PORT=3000
NODE_ENV=production

## API Configuration
APP_BASE_URL=https://themobstate.com
API_BASE_URL=https://api.themobstate.com
APP_URL=https://themobstate.com
ALLOWED_ORIGINS=https://themobstate.com,https://admin.themobstate.com,https://api.themobstate.com

## Client
CLIENT_PORT=8080
ADMIN_PORT=8081

## Game Config
TICK_INTERVAL_MINUTES=5
HUNGER_TICK_AMOUNT=0.1157
THIRST_TICK_AMOUNT=0.1157
HOSPITAL_HEAL_COST=1000
HOSPITAL_HEAL_AMOUNT=50
POLICE_RATIO=10
MAX_FLIGHTS_PER_DAY=100

## External Services (Optional)
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=
MOLLIE_PLAYER_VIP_PRICE_EUR=4.99
MOLLIE_CREW_VIP_PRICE_EUR=9.99
LEONARDO_API_KEY=

## Transactional email (ESP preferred)
# When RESEND_API_KEY is set, outbound mail uses Resend (not local SMTP).
# Keep SMTP_* as fallback only. Never commit real keys.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@themobstate.com
MAIL_FROM_NAME=The Mob State
SMTP_HOST=themobstate.com
SMTP_PORT=465
SMTP_USER=noreply@themobstate.com
SMTP_PASS=

## Firebase Admin
# Prefer one of the env payload options below instead of editing docker-compose.plesk.yml.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

## Client External Images
CLIENT_EXTERNAL_IMAGES_PATH=/var/www/vhosts/themobstate.com/apps/mafia_game/runtime/client-images