NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://mafia_user:password@localhost:3306/mafia_game"

# JWT
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Public URLs (used in email links)
APP_BASE_URL="http://localhost:5173"
API_BASE_URL="http://localhost:3000"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080"

# Firebase Admin (push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH="firebase-service-account.json"

# Crew Wars Discord webhook (optional, fire-and-forget)
CREW_WAR_DISCORD_WEBHOOK_URL=""
CREW_WAR_DISCORD_ENABLED_EVENTS="war_declared,war_started,war_lockdown,war_resolved"
CREW_WAR_DISCORD_MIN_INTERVAL_MS=15000

# Game Config
TICK_INTERVAL_MINUTES=5
POLICE_RATIO=10
MAX_FLIGHTS_PER_DAY=100
