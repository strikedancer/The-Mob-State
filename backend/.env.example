NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://mafia_user:password@localhost:3306/mafia_game"

# JWT
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Public URLs (used in email links)
APP_BASE_URL="http://localhost:5173"
API_BASE_URL="http://localhost:3000"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080"

# Facebook Login + Page posting (optional; leave empty to hide the button)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_OAUTH_REDIRECT_URI=

# Google Sign-In (optional; leave empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Discord community + Sign-In (optional; leave empty to hide the button / invite CTAs)
DISCORD_INVITE_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
# Snowflake of The Mob State guild. With bot token + OAuth scope guilds.join,
# linking/signing in with Discord adds the player to this server automatically.
DISCORD_GUILD_ID=
# Optional dedicated bot token for guild join; defaults to GLOBAL_CHAT_DISCORD_BOT_TOKEN.
DISCORD_BOT_TOKEN=

# World chat Discord bridge (optional). Empty = in-game chat only.
# Dedicated channel, never #updates or Crew Wars ops.
GLOBAL_CHAT_DISCORD_WEBHOOK_URL=
GLOBAL_CHAT_DISCORD_BOT_TOKEN=
GLOBAL_CHAT_DISCORD_CHANNEL_ID=

# Firebase Admin (push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH="firebase-service-account.json"

# Crew Wars Discord webhook (optional, fire-and-forget)
CREW_WAR_DISCORD_WEBHOOK_URL=""
CREW_WAR_DISCORD_ENABLED_EVENTS="war_declared,war_started,war_lockdown,war_resolved"
CREW_WAR_DISCORD_MIN_INTERVAL_MS=15000

# Game Config
TICK_INTERVAL_MINUTES=5
POLICE_RATIO=10
MAX_FLIGHTS_PER_DAY=100
