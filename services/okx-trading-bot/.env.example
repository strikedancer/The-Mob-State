# HTTP server
PORT=3847
# Required: protect /api/* and /dashboard data (set a long random string)
BOT_ADMIN_TOKEN=change-me-to-a-long-random-secret

# Comma-separated allowed browser origins for CORS (admin dev server, production admin URL)
# Example: http://localhost:5173,https://admin.yourdomain.com
CORS_ORIGINS=*

# OKX (public market data needs no keys; keys only for live trading — not used in paper MVP)
OKX_BASE_URL=https://www.okx.com

# Instrument, e.g. BTC-USDT, ETH-USDT
OKX_INST_ID=BTC-USDT
# Candle bar: 1m, 5m, 15m, 1H, 4H, 1D
OKX_BAR=15m
OKX_CANDLE_LIMIT=120

# paper | live  (live order placement is gated — still implement safe default: paper only)
TRADING_MODE=paper

# Paper account
PAPER_INITIAL_USDT=10000
# Max fraction of cash to deploy per buy (0-1)
PAPER_POSITION_FRACTION=0.2

# Bot tick interval (ms)
TICK_INTERVAL_MS=60000

# Optional: live trading (requires API key + passphrase on OKX)
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# OKX_DEMO=0
